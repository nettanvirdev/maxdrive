# Optional, for development only. MaxDrive normally takes the Google OAuth
# client in Settings -> Google connection (stored encrypted on the PC); this
# file is used only while nothing is saved there, and is never bundled.
# Google Cloud Console -> APIs & Services -> Credentials -> "Desktop app" client.
# Walkthrough: docs/guides/google-cloud-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
